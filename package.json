{
	"name": "bootpack-svelte",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "bun --bun vite build",
		"start": "bun run db:migrate && bun ./server.js",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp fmt --check . && vp lint .",
		"format": "vp fmt .",
		"postinstall": "svelte-kit sync",
		"out": "bun outdated",
		"up": "bun update",
		"test:e2e": "playwright test",
		"test": "bun run test:e2e",
		"db:up": "docker compose up -d postgres",
		"db:down": "docker compose down postgres",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@fontsource-variable/figtree": "^5.3.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"eslint-plugin-svelte": "^3.23.1",
		"lefthook": "^2.2.2",
		"svelte-check": "^4.7.6",
		"svelte-obfuscate": "^0.3.0",
		"svg-pathdata": "^9.0.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vite-plus": "^1.2.0"
	},
	"type": "module",
	"dependencies": {
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"postgres": "^3.4.9",
		"posthog-js": "^1.438.12",
		"svelte": "^5.57.2"
	},
	"packageManager": "bun@1.4.0",
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
