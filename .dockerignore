# The image is assembled from an already-installed, already-built tree (see
# Dockerfile), so node_modules/ and build/ are deliberately NOT ignored — they
# are the payload. Everything below is either regenerated, build-only, or must
# never reach a published image.

# Build-only. .svelte-kit is vite's intermediate output; the adapter has already
# copied what the server needs into build/. node_modules/.cache is the
# imagetools variant cache — ~100MB of generated avif/webp that actions/cache
# carries between CI runs and that nothing reads at runtime.
.svelte-kit
node_modules/.cache

# bunfig.toml sets minimumReleaseAge, a guard for interactive `bun add` in dev.
bunfig.toml

# Version control / CI
.git
.gitignore
.github

# Local env & secrets. Runtime env comes from Dokploy; the build-time
# `$env/static/public` values are baked in on the runner before the context is
# assembled. Without this, a local .env would end up in a published GHCR image.
.env
.env.*
!.env.example

# Infra & tooling that runs in CI or locally, never in the image.
# NOTE: drizzle/ and drizzle.config.ts deliberately stay — `bun run start`
# migrates on boot. scripts/dokploy-preview.mjs only ever runs on a runner.
scripts
docker-compose.yml
compose.yaml
Dockerfile
.dockerignore
.dokploy
lefthook.yml

# Tests and their fixtures. Scoped to src/ rather than **/ now that
# node_modules is part of the context: a bare **/*.test.ts would also prune
# files out of installed packages.
playwright.config.ts
e2e
src/**/*.test.ts
src/**/*.spec.ts
test-results
playwright-report

# Docs, editor & OS cruft
*.md
.vscode
.claude
.DS_Store
**/.DS_Store
